<t:Button Type="Default" Text="Default" />
<t:Button Type="Primary" Text="Primary" Click="{command: DoAction()}" />
<t:Button Type="Secondary" Text="Secondary" />
<t:Button Type="Success" Text="Save" Icon="Check" />
<t:Button Type="Danger" Text="Delete" Icon="Trash" />
<t:Button Type="Warning" Text="Warning" Size="Small" />
<t:Button Type="Info" Text="Info" Size="Large" />
<t:Button Type="Ghost" Text="Ghost" />
<t:Button Type="Link" Text="Link" />
<t:Button Type="Primary" Text="Disabled" Enabled="false" />
<t:Button Type="Primary" Text="{value: ButtonLabel}" Enabled="{value: IsEnabled}" Click="{command: DoAction()}" />