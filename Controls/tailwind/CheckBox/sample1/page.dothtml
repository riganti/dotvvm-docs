<div class="flex flex-col gap-2">
    <t:CheckBox Text="I agree to the terms" Checked="{value: CheckboxValue}" />
    <t:CheckBox Text="Disabled (unchecked)" Enabled="false" Checked="{value: DisabledCheckboxUnchecked}" />
    <t:CheckBox Text="Disabled (checked)" Enabled="false" Checked="{value: DisabledCheckboxChecked}" />
</div>
