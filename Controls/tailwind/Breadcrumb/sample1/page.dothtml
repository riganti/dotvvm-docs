<t:Breadcrumb>
    <t:BreadcrumbItem Text="Home" NavigateUrl="/" />
    <t:BreadcrumbItem Text="Library" NavigateUrl="/library" />
    <t:BreadcrumbItem Text="Data" IsActive="true" />
</t:Breadcrumb>

<t:Breadcrumb DataSource="{value: BreadcrumbItems}"
              ItemText="{value: Text}"
              ItemNavigateUrl="{value: Url}"
              ItemIsActive="{value: IsActive}" />