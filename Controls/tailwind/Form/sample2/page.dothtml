<div class="space-y-4">
    <t:Form>
        <HeaderTemplate>
            <h2 class="mb-0 text-lg font-semibold">Customer Details</h2>
        </HeaderTemplate>
        <ContentTemplate>
            <dot:ValidationSummary IncludeErrorsFromChildren="true" />
            <t:Row>
                <t:TextBoxFormField LabelText="First name" Text="{value: FirstName}" Size="Half" />
                <t:TextBoxFormField LabelText="Last name" Text="{value: LastName}" Size="Half" />
            </t:Row>
            <t:TextBoxFormField LabelText="Email address" Text="{value: Email}" />
            <t:Row>
                <t:TextBoxFormField LabelText="Street" Text="{value: Street}" Size="Half" />
                <t:TextBoxFormField LabelText="ZIP / Postal code" Text="{value: Zip}" Size="Half" />
            </t:Row>
            <t:Row>
                <t:CheckBoxFormField Text="Subscribe to newsletter" Checked="{value: Subscribe}" />
                <t:CheckBoxFormField Text="Agree to terms" Checked="{value: AgreeToTerms}" />
                <t:CheckBoxFormField Text="Disabled checkbox" Checked="{value: Subscribe}" Enabled="false" />
            </t:Row>
        </ContentTemplate>
        <FooterTemplate>
            <t:Button Type="Primary" Text="Save" IsSubmitButton="true" Click="{command: Save()}" Validation.Target="{value: _root}" />
            <t:Button Type="Default" Text="Cancel" Click="{command: Reset()}" Validation.Enabled="false" />
        </FooterTemplate>
    </t:Form>

    <div Visible="{value: Saved}">
        <t:Alert Type="Success" Text="Form saved successfully!" />
    </div>
</div>
