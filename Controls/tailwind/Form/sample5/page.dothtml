<t:Form HeaderText="Disabled Fields">
    <ContentTemplate>
        <t:TextBoxFormField LabelText="Disabled text box" Text="{value: FullName}" Enabled="false" />
        <t:ComboBoxFormField LabelText="Disabled combo box"
            DataSource="{value: Countries}"
            SelectedValue="{value: SelectedCountry}"
            ItemTextBinding="{value: Name}"
            ItemValueBinding="{value: Code}"
            Enabled="false" />
        <t:CheckBoxFormField Text="Disabled checkbox" Checked="{value: Subscribe}" Enabled="false" />
    </ContentTemplate>
</t:Form>

