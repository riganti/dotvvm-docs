<div class="mb-8 max-w-sm mx-auto stack-layout">
    <t:Range SelectedValue="{value: ColorValue}" Color="Primary" ShowValue="true" ValueSuffix=" %" />
    <t:Range SelectedValue="{value: ColorValue}" Color="Secondary" ShowValue="true" ValueSuffix=" %" />
    <t:Range SelectedValue="{value: ColorValue}" Color="Success" ShowValue="true" ValueSuffix=" %" />
    <t:Range SelectedValue="{value: ColorValue}" Color="Warning" ShowValue="true" ValueSuffix=" %" />
    <t:Range SelectedValue="{value: ColorValue}" Color="Danger" ShowValue="true" ValueSuffix=" %" />
    <t:Range SelectedValue="{value: ColorValue}" Color="Info" ShowValue="true" ValueSuffix=" %" />
</div>
