<div class="space-y-3 max-w-md">
    <t:CheckBox Text="Enable slider" Checked="{value: IsEnabled}" />

    <t:Range SelectedValue="{value: Temperature}"
             MinValue="-20"
             MaxValue="40"
             Step="0.5"
             ShowValue="true"
             FormatString="n1"
             Enabled="{value: IsEnabled}" />
</div>

<p>Temperature: <strong>{{value: Temperature}}</strong> °C</p>
