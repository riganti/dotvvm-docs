<div class="space-y-3 max-w-md">
    <t:CheckBox Text="Enable ComboBox" Checked="{value: IsEnabled}" />

    <t:ComboBox DataSource="{value: Countries}"
                SelectedValue="{value: SelectedCountry}"
                ItemTextBinding="{value: Name}"
                ItemValueBinding="{value: Code}"
                Placeholder="Choose a country"
                Enabled="{value: IsEnabled}"
                Changed="{command: IncrementChanges()}" />

    <t:ComboBox DataSource="{value: Sizes}" SelectedValue="{value: SelectedSize}" Size="Small" />
</div>

<p>Selected country: <strong>{{value: SelectedCountry ?? "(none)"}}</strong></p>
<p><code>Changed</code> command count: <strong>{{value: ChangeCount}}</strong></p>
<p>Selected size: <strong>{{value: SelectedSize}}</strong></p>
