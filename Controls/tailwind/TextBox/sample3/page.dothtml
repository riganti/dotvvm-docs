<div class="flex flex-col gap-2">
    <div class="form-row bg-gray-100 rounded p-2">
        <t:TextBoxFormField LabelText="Quarter - 25%" Text="{value: TextValueQuarter}" Size="Quarter" />
    </div>
    <div class="form-row bg-gray-100 rounded p-2">
        <t:TextBoxFormField LabelText="Half - 50%" Text="{value: TextValueHalf}" Size="Half" />
    </div>
    <div class="form-row bg-gray-100 rounded p-2">
        <t:TextBoxFormField LabelText="Three Quarters - 75%" Text="{value: TextValueThreeQuarters}" Size="ThreeQuarters" />
    </div>
    <div class="form-row bg-gray-100 rounded p-2">
        <t:TextBoxFormField LabelText="Full - 100%" Text="{value: TextValueFull}" Size="Full" />
    </div>
    <div class="form-row bg-gray-100 rounded p-2">
        <t:TextBoxFormField LabelText="Half" Text="{value: TextValueHalf}" Size="Half" />
        <t:TextBoxFormField LabelText="Quarter" Text="{value: TextValueQuarter}" Size="Quarter" />
        <t:TextBoxFormField LabelText="Quarter" Text="{value: TextValueQuarter}" Size="Quarter" />
    </div>
</div>

