<div class="flex flex-col gap-4">
    <t:ProgressBar Value="75" Color="{value: SelectedColor}" />
    <div class="flex gap-2 flex-wrap">
        <t:Button Text="Default" Click="{command: SetColor(0)}" Size="Small" />
        <t:Button Text="Primary" Click="{command: SetColor(1)}" Size="Small" />
        <t:Button Text="Secondary" Click="{command: SetColor(2)}" Size="Small" />
        <t:Button Text="Success" Click="{command: SetColor(3)}" Size="Small" />
        <t:Button Text="Warning" Click="{command: SetColor(4)}" Size="Small" />
        <t:Button Text="Danger" Click="{command: SetColor(5)}" Size="Small" />
        <t:Button Text="Info" Click="{command: SetColor(6)}" Size="Small" />
    </div>
</div>

