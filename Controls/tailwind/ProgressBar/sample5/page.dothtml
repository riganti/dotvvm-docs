<div class="flex flex-col gap-4">
    <div>
        <p class="text-sm mb-2">ShowLabel="true"</p>
        <t:ProgressBar Value="60" Color="Success" ShowLabel="true" />
    </div>
    <div>
        <p class="text-sm mb-2">ShowLabel with binding</p>
        <t:ProgressBar Value="80" Color="Primary" ShowLabel="{value: ShowLabel}" />
    </div>
    <t:CheckBox Text="Show Label" Checked="{value: ShowLabel}" />
</div>

