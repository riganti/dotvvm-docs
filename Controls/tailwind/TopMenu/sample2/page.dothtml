<t:TopMenu>
    <StartTemplate>
        <a href="#" style="font-size: 1.1rem; font-weight: 700; color: #2563eb; text-decoration: none;">MyApp</a>
    </StartTemplate>
    <MiddleTemplate>
        {{-- Plain text item --}}
        <t:MenuItem Text="Dashboard" NavigateUrl="#" IsActive="true" />

        {{-- Template item with a star label --}}
        <t:MenuItem NavigateUrl="#featured">
            <span style="font-weight: 700; color: #f59e0b;">★ Featured</span>
        </t:MenuItem>

        {{-- Template item with an inline badge --}}
        <t:MenuItem NavigateUrl="#new">
            <span>New <span style="display: inline-block; background: #ef4444; color: white; font-size: 0.625rem; padding: 0 0.25rem; border-radius: 9999px;">NEW</span></span>
        </t:MenuItem>
    </MiddleTemplate>
</t:TopMenu>
