<div class="border border-gray-200 rounded-xl">
    <t:TopMenu>
        <StartTemplate>
            <a href="#" class="text-lg font-bold text-blue-600 no-underline">MyApp</a>
        </StartTemplate>
        <MiddleTemplate>
            <t:MenuItem Text="Home" NavigateUrl="#" IsActive="true" />
            <t:MenuItemSeparator />
            <t:MenuItem Text="About" NavigateUrl="#" />
            <t:MenuItemSeparator />
            <t:MenuItem Text="Contact" NavigateUrl="#" />
        </MiddleTemplate>
    </t:TopMenu>

    <div class="p-4 bg-gray-50 min-h-20">
        <p>The separator renders as a vertical line between navigation items.</p>
    </div>
</div>
