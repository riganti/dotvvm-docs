<t:DropDownButton Text="Actions" Type="Primary">
    <t:DropDownItem Text="Edit" Click="{command: _root.ItemClicked("Edit")}"  />
    <t:DropDownItem Text="Duplicate" Click="{command: _root.ItemClicked("Duplicate")}" />
    <t:DropDownItem Text="Archive" Click="{command: _root.ItemClicked("Archive")}" />
    <t:DropDownItem Text="Delete" Click="{command: _root.ItemClicked("Delete")}" />
</t:DropDownButton>

<p>Last action: {{value: LastClicked}}</p>