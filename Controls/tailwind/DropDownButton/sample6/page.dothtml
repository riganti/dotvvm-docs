<div class="flex flex-col gap-4">
    <t:DropDownButton Text="Menu" Type="Secondary"
        DataSource="{value: MenuItems}"
        ItemText="{value: _this}"
        ItemClick="{command: _parent.ItemClicked(_this)}" />
    <p class="text-sm">Last clicked: <strong>{{value: LastClicked}}</strong></p>
</div>

