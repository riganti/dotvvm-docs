<div class="flex flex-col gap-2">
    <t:StackLayout Justify="Start" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="Start" />
        <t:Button Type="Secondary" Text="Justified" />
    </t:StackLayout>
    <t:StackLayout Justify="Center" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="Center" />
        <t:Button Type="Secondary" Text="Justified" />
    </t:StackLayout>
    <t:StackLayout Justify="End" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="End" />
        <t:Button Type="Secondary" Text="Justified" />
    </t:StackLayout>
    <t:StackLayout Justify="SpaceBetween" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="Space" />
        <t:Button Type="Secondary" Text="Between" />
    </t:StackLayout>
    <t:StackLayout Justify="SpaceAround" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="Space" />
        <t:Button Type="Secondary" Text="Around" />
    </t:StackLayout>
    <t:StackLayout Justify="SpaceEvenly" Orientation="Horizontal" class="bg-gray-300 p-2">
        <t:Button Type="Primary" Text="Space" />
        <t:Button Type="Secondary" Text="Evenly" />
    </t:StackLayout>
</div>

