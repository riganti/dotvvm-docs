<div class="flex flex-col gap-2">
    <t:DockLayout Gap="None">
        <StartContent><div class="bg-gray-200 p-2">Start</div></StartContent>
        <EndContent><div class="bg-gray-200 p-2">End (None)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="Small">
        <StartContent><div class="bg-gray-200 p-2">Start</div></StartContent>
        <EndContent><div class="bg-gray-200 p-2">End (Small)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="Large">
        <StartContent><div class="bg-gray-200 p-2">Start</div></StartContent>
        <EndContent><div class="bg-gray-200 p-2">End (Large)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="ExtraLarge">
        <StartContent><div class="bg-gray-200 p-2">Start</div></StartContent>
        <EndContent><div class="bg-gray-200 p-2">End (Extra Large)</div></EndContent>
    </t:DockLayout>
</div>

