<div class="flex flex-col gap-2">
    <t:DockLayout Gap="None">
        <StartContent><div class="bg-gray-700 text-white p-2 rounded">Start</div></StartContent>
        <Content><div class="bg-info-700 text-white p-2 rounded">Content</div></Content>
        <EndContent><div class="bg-gray-700 text-white p-2 rounded">End (None)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="Small">
        <StartContent><div class="bg-gray-700 text-white p-2 rounded">Start</div></StartContent>
        <Content><div class="bg-info-700 text-white p-2 rounded">Content</div></Content>
        <EndContent><div class="bg-gray-700 text-white p-2 rounded">End (Small)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="Large">
        <StartContent><div class="bg-gray-700 text-white p-2 rounded">Start</div></StartContent>
        <Content><div class="bg-info-700 text-white p-2 rounded">Content</div></Content>
        <EndContent><div class="bg-gray-700 text-white p-2 rounded">End (Large)</div></EndContent>
    </t:DockLayout>
    <t:DockLayout Gap="ExtraLarge">
        <StartContent><div class="bg-gray-700 text-white p-2 rounded">Start</div></StartContent>
        <Content><div class="bg-info-700 text-white p-2 rounded">Content</div></Content>
        <EndContent><div class="bg-gray-700 text-white p-2 rounded">End (ExtraLarge)</div></EndContent>
    </t:DockLayout>
</div>

