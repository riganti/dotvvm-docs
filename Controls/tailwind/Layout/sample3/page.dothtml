<div class="flex flex-col gap-2">
    <t:StackLayout Alignment="Start" Orientation="Horizontal" class="h-20 bg-gray-200 p-2">
        <t:Button Type="Primary" Text="Start" />
        <t:Button Type="Secondary" Text="Aligned" />
    </t:StackLayout>
    <t:StackLayout Alignment="Center" Orientation="Horizontal" class="h-20 bg-gray-200 p-2">
        <t:Button Type="Primary" Text="Center" />
        <t:Button Type="Secondary" Text="Aligned" />
    </t:StackLayout>
    <t:StackLayout Alignment="End" Orientation="Horizontal" class="h-20 bg-gray-200 p-2">
        <t:Button Type="Primary" Text="End" />
        <t:Button Type="Secondary" Text="Aligned" />
    </t:StackLayout>
    <t:StackLayout Alignment="Stretch" Orientation="Horizontal" class="h-20 bg-gray-200 p-2">
        <t:Button Type="Primary" Text="Stretch" />
        <t:Button Type="Secondary" Text="Aligned" />
    </t:StackLayout>
</div>

