<t:Button Type="Danger" Text="Delete Item" Click="{command: DeleteItem()}">
    <PostBack.Handlers>
        <t:ModalConfirmPostBackHandler Title="Delete Item" Message="Are you sure you want to delete this item? This action cannot be undone." CancelButtonText="Cancel" ConfirmButtonText="Yes, Delete" />
    </PostBack.Handlers>
</t:Button>

<p class="mt-3">{{value: DeleteResult}}</p>

