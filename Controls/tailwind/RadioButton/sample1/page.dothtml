<div class="flex flex-col gap-2">
    <t:RadioButton Text="Option 1" CheckedValue="1" CheckedItem="{value: RadioValue}" />
    <t:RadioButton Text="Option 2" CheckedValue="2" CheckedItem="{value: RadioValue}" />
    <t:RadioButton Text="Option 3" CheckedValue="3" CheckedItem="{value: RadioValue}" />
    <t:RadioButton Text="Disabled option" CheckedValue="1" CheckedItem="{value: RadioValue}" Enabled="false" />
</div>
