<div class="mb-8 max-w-sm mx-auto stack-layout">
    <div>
        <p>Small</p>
        <t:RangeInterval SelectedMinValue="{value: SizeMin}" SelectedMaxValue="{value: SizeMax}" Size="Small" ValueSuffix=" %" />
    </div>
    <div>
        <p>Default</p>
        <t:RangeInterval SelectedMinValue="{value: SizeMin}" SelectedMaxValue="{value: SizeMax}" Size="Default" ValueSuffix=" %" />
    </div>
    <div>
        <p>Large</p>
        <t:RangeInterval SelectedMinValue="{value: SizeMin}" SelectedMaxValue="{value: SizeMax}" Size="Large" ValueSuffix=" %" />
    </div>
    <div>
        <p>ExtraLarge</p>
        <t:RangeInterval SelectedMinValue="{value: SizeMin}" SelectedMaxValue="{value: SizeMax}" Size="ExtraLarge" ValueSuffix=" %" />
    </div>
</div>
