<div class="relative h-[300px] border border-gray-200 rounded-md overflow-hidden bg-gray-900">
    <div class="px-4 py-3 border-b border-gray-700">
        <button class="hamburger-button" data-sidemenu-toggle="demo-mobile-menu" style="display:flex">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>

    <div class="side-menu-mobile-overlay"></div>

    <div class="side-menu-mobile" id="demo-mobile-menu">
        <t:SideMenu>
            <t:SideMenuSection Title="Navigation">
                <t:MenuItem Text="Home" NavigateUrl="#" Icon="Home" IsActive="true" />
                <t:MenuItem Text="About" NavigateUrl="#" Icon="InformationCircle" />
            </t:SideMenuSection>
        </t:SideMenu>
    </div>

    <div class="px-6 py-6 text-gray-400 text-sm">
        <h3 class="text-white">Main Content Area</h3>
        <p>
            This area represents the page content next to the sidebar.
        </p>
        <p>Click the hamburger button (top-left) to toggle the mobile sidebar.</p>
    </div>
</div>
